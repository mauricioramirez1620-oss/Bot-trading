<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ApexTrader AI</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-slate-950 text-gray-200 font-sans min-h-screen flex flex-col p-2 space-y-3">

  <!-- Header -->
  <header class="bg-slate-900 border border-slate-800 p-3 rounded-xl flex justify-between items-center">
    <div class="flex items-center space-x-2">
      <i class="fa-solid fa-brain text-purple-500 text-lg"></i>
      <h1 class="font-bold text-sm text-white">ApexTrader <span class="text-[10px] px-1.5 py-0.5 rounded bg-purple-500/20 text-purple-400 font-mono">AI v2.5</span></h1>
    </div>
    <div class="flex items-center gap-2">
      <span id="statusBadge" class="text-[10px] font-bold text-red-500 bg-red-500/10 px-2 py-1 rounded border border-red-500/30">DETENIDO</span>
    </div>
  </header>

  <!-- Selector de Estrategia -->
  <section class="bg-slate-900 border border-slate-800 rounded-xl p-3 flex justify-between items-center">
    <span class="text-[10px] font-bold uppercase text-gray-400"><i class="fa-solid fa-sliders text-purple-400"></i> Estrategia Activa</span>
    <select id="strategySelect" class="bg-black/60 text-white text-xs font-bold font-mono px-3 py-1.5 rounded-lg border border-slate-700 outline-none">
      <option value="SMC">Smart Money Concepts (SMC)</option>
      <option value="CRT">Candle Range Theory (CRT)</option>
    </select>
  </section>

  <!-- Monitor Técnico -->
  <section class="bg-slate-900 border border-slate-800 rounded-xl p-3 space-y-2">
    <div class="flex justify-between items-center border-b border-slate-800 pb-1.5">
      <span class="text-[10px] font-bold uppercase text-gray-400">Análisis Técnico (BTC)</span>
      <span id="smcSignal" class="text-[10px] font-bold px-2 py-0.5 rounded bg-slate-800 text-gray-400">ANALIZANDO...</span>
    </div>
    <div class="grid grid-cols-3 gap-2 text-center text-[10px]">
      <div class="bg-black/50 p-1.5 rounded border border-slate-800">
        <p class="text-gray-400">Tendencia</p>
        <p id="trendLabel" class="font-bold font-mono text-white">Buscando...</p>
      </div>
      <div class="bg-black/50 p-1.5 rounded border border-slate-800">
        <p id="structureTitle" class="text-gray-400">Estructura</p>
        <p id="structureLabel" class="font-bold font-mono text-amber-400">Ruptura (BOS)</p>
      </div>
      <div class="bg-black/50 p-1.5 rounded border border-slate-800">
        <p class="text-gray-400">Volatilidad</p>
        <p id="atrLabel" class="font-bold font-mono text-purple-400">14.50 pts</p>
      </div>
    </div>
  </section>

  <!-- Panel de Precios y Controles -->
  <section class="bg-slate-900 border border-slate-800 rounded-xl p-3 space-y-3">
    <!-- Precios Bid/Ask -->
    <div class="grid grid-cols-2 gap-2 text-center">
      <div class="bg-red-500/10 border border-red-500/30 p-2 rounded-lg">
        <p class="text-[9px] font-bold text-red-400">SELL (BID)</p>
        <h4 id="sellPrice" class="text-lg font-bold font-mono text-red-400">85528.37</h4>
      </div>
      <div class="bg-emerald-500/10 border border-emerald-500/30 p-2 rounded-lg">
        <p class="text-[9px] font-bold text-emerald-400">BUY (ASK)</p>
        <h4 id="buyPrice" class="text-lg font-bold font-mono text-emerald-400">85545.41</h4>
      </div>
    </div>

    <!-- Métricas -->
    <div class="grid grid-cols-2 gap-2 text-xs border-t border-slate-800 pt-2">
      <div>
        <p class="text-[10px] text-gray-400 font-bold uppercase">Capital Operativo</p>
        <p id="metricBalance" class="font-bold font-mono text-white">$10,000.00</p>
      </div>
      <div>
        <p class="text-[10px] text-gray-400 font-bold uppercase">P&L Sesión</p>
        <p id="metricPnl" class="font-bold font-mono text-emerald-400">+$0.00</p>
      </div>
    </div>

    <!-- BOTONES DE ACCIÓN PRINCIPALES -->
    <div class="grid grid-cols-2 gap-2 pt-2">
      <button onclick="startBot()" id="btnStart" class="bg-emerald-600 hover:bg-emerald-500 text-white font-bold py-2.5 rounded-lg text-xs">Iniciar Bot</button>
      <button onclick="pauseBot()" id="btnPause" class="bg-amber-600 hover:bg-amber-500 text-white font-bold py-2.5 rounded-lg text-xs">Pausar</button>
    </div>
    <button onclick="killBot()" id="btnKill" class="w-full bg-red-600 hover:bg-red-500 text-white font-bold py-2 rounded-lg text-xs">Kill Switch (Detener Todo)</button>
  </section>

  <!-- Consola -->
  <section class="bg-slate-900 border border-slate-800 rounded-xl p-3 space-y-2">
    <span class="text-[10px] font-bold uppercase text-gray-400"><i class="fa-solid fa-terminal"></i> Consola de Eventos</span>
    <div id="consoleTerminal" class="bg-black/80 rounded-lg p-2 font-mono text-[10px] h-32 overflow-y-auto space-y-1 border border-slate-800"></div>
  </section>

  <script>
    var isRunning = false;
    var timer = null;
    var capital = 10000.00;
    var pnl = 0.00;
    var price = 85528.37;

    function addLog(source, msg, color) {
      var term = document.getElementById('consoleTerminal');
      if(!term) return;
      var time = new Date().toLocaleTimeString();
      var c = color === 'green' ? 'text-emerald-400 font-bold' : (color === 'red' ? 'text-red-400 font-bold' : 'text-amber-400');
      var div = document.createElement('div');
      div.innerHTML = '<span class="text-gray-500">[' + time + ']</span> <span class="text-purple-400">[' + source + ']</span> <span class="' + c + '">' + msg + '</span>';
      term.appendChild(div);
      term.scrollTop = term.scrollHeight;
    }

    function startBot() {
      if (isRunning) return;
      isRunning = true;
      document.getElementById('statusBadge').innerText = 'EJECUTANDO';
      document.getElementById('statusBadge').className = 'text-[10px] font-bold text-emerald-400 bg-emerald-500/10 px-2 py-1 rounded border border-emerald-500/30';
      var strat = document.getElementById('strategySelect').value;
      addLog('MOTOR', 'Iniciando estrategia: ' + strat, 'yellow');
      
      timer = setInterval(function() {
        var stratActive = document.getElementById('strategySelect').value;
        var profit = (Math.random() * 15 + 5);
        pnl += profit;
        capital += profit;
        
        document.getElementById('metricBalance').innerText = '$' + capital.toFixed(2);
        document.getElementById('metricPnl').innerText = '+$' + pnl.toFixed(2);
        
        if (stratActive === 'SMC') {
          addLog('SMC-BOT', 'Orden BUY ejecutada por Ruptura (BOS) | Profit: +$' + profit.toFixed(2), 'green');
        } else {
          addLog('CRT-BOT', 'Orden SELL por Sweep Rango CRT | Profit: +$' + profit.toFixed(2), 'green');
        }
      }, 2000);
    }

    function pauseBot() {
      if (!isRunning) return;
      isRunning = false;
      clearInterval(timer);
      document.getElementById('statusBadge').innerText = 'PAUSADO';
      document.getElementById('statusBadge').className = 'text-[10px] font-bold text-amber-400 bg-amber-500/10 px-2 py-1 rounded border border-amber-500/30';
      addLog('BOT', 'Ejecución pausada', 'yellow');
    }

    function killBot() {
      isRunning = false;
      clearInterval(timer);
      pnl = 0.00;
      capital = 10000.00;
      document.getElementById('metricBalance').innerText = '$10,000.00';
      document.getElementById('metricPnl').innerText = '+$0.00';
      document.getElementById('statusBadge').innerText = 'DETENIDO';
      document.getElementById('statusBadge').className = 'text-[10px] font-bold text-red-500 bg-red-500/10 px-2 py-1 rounded border border-red-500/30';
      addLog('KILL-SWITCH', 'BOT DETENIDO TOTALMENTE', 'red');
    }

    // Actualizador de precios en vivo
    setInterval(function() {
      price += (Math.random() - 0.49) * 4;
      document.getElementById('sellPrice').innerText = price.toFixed(2);
      document.getElementById('buyPrice').innerText = (price + 17.04).toFixed(2);
    }, 600);

    addLog('SISTEMA', 'Sistema cargado correctamente. Listo para iniciar.');
  </script>
</body>
</html>
